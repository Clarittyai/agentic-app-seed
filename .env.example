# ============================================================================
# CLARITY AGENTIC APP - ENVIRONMENT CONFIGURATION
# ============================================================================
# Quick Start: Copy this file to .env and add your Anthropic API key
#
# cp .env.example .env
# Then edit .env and add your ANTHROPIC_API_KEY
#
# Get your API key at: https://console.anthropic.com/
# ============================================================================

# ============================================================================
# REQUIRED: AI Configuration
# ============================================================================

# Anthropic Claude API Key (Required)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============================================================================
# OPTIONAL: Development Settings (Auto-configured with smart defaults)
# ============================================================================

# Database (Auto-configured by Docker Compose - no need to change)
# DATABASE_URL=postgresql://clarity_user:clarity_password:@localhost:5432/clarity_agentic_app

# Server Ports (Auto-configured - no need to change)
# BACKEND_PORT=8000
# FRONTEND_PORT=3200
# POSTGRES_PORT=5432

# CORS (Auto-configured - no need to change)
# FRONTEND_URL=http://localhost:3200

# Logging (Auto-configured - no need to change)
# LOG_LEVEL=INFO
# DEBUG=false

# ============================================================================
# OPTIONAL: App-Specific Settings (From app-config.json)
# ============================================================================
# These settings can be configured through the Clarity Platform UI
# For local development, uncomment and modify as needed

# AI Operation Mode (fast, balanced, quality)
# AI_OPERATION_MODE=balanced

# AI Creativity Level (0-100)
# AI_RESPONSE_TEMPERATURE=70

# Workflow Retry Settings
# WORKFLOW_RETRY_FAILED=true
# WORKFLOW_MAX_RETRIES=2
# WORKFLOW_PARALLEL_LIMIT=3

# Notifications
# NOTIFY_ON_WORKFLOW_COMPLETE=true
# NOTIFY_ON_WORKFLOW_FAILURE=true
# NOTIFICATION_EMAIL=

# Slack Integration (Optional)
# ENABLE_SLACK_INTEGRATION=false
# SLACK_WEBHOOK_URL=

# Debug Mode
# DEBUG_MODE=false

# ============================================================================
# NOTES
# ============================================================================
#
# 🚀 Quick Start (60 seconds):
# ------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Add your ANTHROPIC_API_KEY in the .env file
# 3. Run: ./start.sh (or docker-compose up)
# 4. Done! Your app is running at http://localhost:8000
#
# 📖 What's Auto-Configured:
# --------------------------
# - Database connection (PostgreSQL via Docker)
# - Ports (8000 for backend, 3200 for frontend, 5432 for PostgreSQL)
# - CORS settings
# - Logging configuration
# - Health checks
# - All infrastructure settings
#
# 🎯 For Production Deployment:
# ------------------------------
# When deploying to Clarity Marketplace, the platform automatically manages:
# - Database provisioning and credentials
# - Port allocation and load balancing
# - Security secrets (JWT, session keys)
# - Monitoring and logging configuration
# - Resource limits and cost management
#
# You don't need to configure any of those - the platform handles it!
#
# ============================================================================
