# ============================================================================
# CLARITY AGENTIC APP - USER CONFIGURATION
# ============================================================================
# These settings control how your app behaves and are configured through
# the Clarity Platform dashboard UI.
#
# ⚠️  DO NOT EDIT THIS FILE DIRECTLY
# Use the Clarity Platform Settings page to configure these values.
#
# Infrastructure settings (database, ports, API keys) are managed automatically
# by Clarity Platform in .env.platform and should never be edited manually.
# ============================================================================

# ============================================================================
# AI CONFIGURATION
# ============================================================================

# AI Operation Mode
# Options: fast, balanced, quality
# - fast: Quick responses, lower cost, good for simple tasks
# - balanced: Good balance of speed and quality (recommended)
# - quality: Best quality responses, slower, higher cost
AI_OPERATION_MODE=balanced

# AI Creativity Level (0-100)
# 0 = Very consistent and predictable responses
# 50 = Balanced creativity
# 100 = Very creative and experimental responses
AI_RESPONSE_TEMPERATURE=70

# ============================================================================
# WORKFLOW EXECUTION
# ============================================================================

# Auto-retry failed workflows
WORKFLOW_RETRY_FAILED=true

# Maximum number of retry attempts (0-5)
WORKFLOW_MAX_RETRIES=2

# Maximum parallel workflows per user (1-10)
WORKFLOW_PARALLEL_LIMIT=3

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Notify when workflows complete successfully
NOTIFY_ON_WORKFLOW_COMPLETE=true

# Notify when workflows fail
NOTIFY_ON_WORKFLOW_FAILURE=true

# Email for notifications (leave empty to use Clarity account email)
NOTIFICATION_EMAIL=

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================

# Enable Slack notifications
ENABLE_SLACK_INTEGRATION=false

# Slack Webhook URL (get from Slack: Settings > Incoming Webhooks)
# Only needed if ENABLE_SLACK_INTEGRATION=true
SLACK_WEBHOOK_URL=

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Enable debug mode (verbose logging)
# Only enable when troubleshooting issues
DEBUG_MODE=false

# Custom metadata (advanced users only, must be valid JSON)
CUSTOM_METADATA=

# ============================================================================
# NOTES
# ============================================================================
#
# Configuration Architecture:
# ---------------------------
# Your app uses TWO configuration files:
#
# 1. .env (THIS FILE)
#    - App-specific settings configured by YOU
#    - Controls app behavior, notifications, integrations
#    - Safe to modify through Clarity Platform UI
#
# 2. .env.platform (Platform-managed)
#    - Infrastructure settings managed by Clarity Platform
#    - Database connections, API keys, ports, security
#    - NEVER edit manually - managed automatically
#
# Configuration Priority:
# -----------------------
# .env.platform > .env
# Platform settings always take precedence to ensure security and stability.
#
# How to Change Settings:
# -----------------------
# 1. Go to Clarity Platform Dashboard
# 2. Select your app
# 3. Click "Settings" tab
# 4. Update values in the form
# 5. Click "Save Changes"
# 6. Changes apply immediately (no restart needed for most settings)
#
# For Developers:
# ---------------
# When building your app, define your configuration needs in app-config.json
# The Clarity Platform will automatically:
# - Generate UI forms for users
# - Validate inputs
# - Update this .env file
# - Reload your app config without restart
#
# See app-config.json for the full configuration schema definition.
#
# ============================================================================
