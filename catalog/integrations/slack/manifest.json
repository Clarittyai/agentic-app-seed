{
  "id": "slack",
  "kind": "integration",
  "category": "communication",
  "transport": "native",
  "version": "1.0.0",
  "name": "Slack",
  "vendor": "Slack",
  "description": "Post messages and read conversations across the authenticated user's Slack workspace.",
  "intentHints": ["post to a slack channel", "alert the team in slack", "search slack messages"],
  "authType": "oauth2",
  "oauthConfig": {
    "authorizeUrl": "https://slack.com/oauth/v2/authorize",
    "tokenUrl": "https://slack.com/api/oauth.v2.access",
    "scopes": ["chat:write", "channels:read", "users:read"],
    "clientIdSecretRef": "secretsmanager:claritty/integrations/slack/client"
  },
  "providedTools": [
    { "id": "slack.post_message", "description": "Post a message to a channel.", "input": { "channel": { "type": "string", "required": true }, "text": { "type": "string", "required": true } }, "output": { "ts": { "type": "string", "required": true } } },
    { "id": "slack.list_channels", "description": "List channels in the workspace.", "input": {}, "output": { "channels": { "type": "array", "required": true } } },
    { "id": "slack.lookup_user", "description": "Find a user by email.", "input": { "email": { "type": "string", "required": true } }, "output": { "user_id": { "type": "string", "required": true } } }
  ]
}
