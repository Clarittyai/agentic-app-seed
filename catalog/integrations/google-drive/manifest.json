{
  "id": "google-drive",
  "kind": "integration",
  "category": "files",
  "transport": "native",
  "version": "1.0.0",
  "name": "Google Drive",
  "vendor": "Google",
  "description": "List, upload, and export files from the user's Google Drive.",
  "intentHints": [
    "find a file in drive",
    "upload to drive",
    "export a doc"
  ],
  "authType": "oauth2",
  "_authNote": "OAuth endpoints, scopes, client secret ref and any identity step are PLATFORM-OWNED \u2014 they live in the private clarity-api (integrations-v2/config/oauth-configs.ts), never in this public repo. This manifest only declares that the integration uses oauth2 and which tools it provides.",
  "providedTools": [
    {
      "id": "gdrive.list_files",
      "description": "List files matching a query.",
      "input": {
        "query": {
          "type": "string",
          "required": false
        }
      },
      "output": {
        "files": {
          "type": "array",
          "required": true
        }
      }
    },
    {
      "id": "gdrive.upload_file",
      "description": "Upload a file.",
      "input": {
        "name": {
          "type": "string",
          "required": true
        },
        "content_base64": {
          "type": "string",
          "required": true
        },
        "mime_type": {
          "type": "string",
          "required": false
        }
      },
      "output": {
        "file_id": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "id": "gdrive.export_doc",
      "description": "Export a Google Doc to a given format.",
      "input": {
        "file_id": {
          "type": "string",
          "required": true
        },
        "mime_type": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "content_base64": {
          "type": "string",
          "required": true
        }
      }
    }
  ]
}
