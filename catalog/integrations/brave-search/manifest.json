{
  "id": "brave-search",
  "kind": "integration",
  "category": "productivity",
  "transport": "native",
  "version": "1.0.0",
  "name": "Brave Search",
  "vendor": "Brave",
  "description": "Search the web with Brave Search to ground content in current results. Uses an API key (X-Subscription-Token).",
  "intentHints": [
    "web search",
    "search the web",
    "current results",
    "ground in web results"
  ],
  "authType": "apiKey",
  "credentialFields": [
    {
      "key": "api_key",
      "label": "Subscription token",
      "type": "password",
      "required": true,
      "help": "brave.com/search/api \u2192 your subscription."
    }
  ],
  "providedTools": [
    {
      "id": "brave-search.search",
      "description": "Search the web and return current results.",
      "input": {
        "query": {
          "type": "string",
          "required": true
        },
        "count": {
          "type": "number",
          "required": false
        }
      },
      "output": {
        "results": {
          "type": "array",
          "required": true
        }
      }
    }
  ]
}
