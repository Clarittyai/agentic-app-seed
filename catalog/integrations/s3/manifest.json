{
  "id": "s3",
  "kind": "integration",
  "category": "files",
  "transport": "native",
  "version": "1.0.0",
  "name": "AWS S3",
  "vendor": "AWS",
  "description": "Read and write objects in S3 buckets using IAM credentials.",
  "intentHints": ["put to s3", "list s3 objects", "fetch from s3"],
  "authType": "apiKey",
  "providedTools": [
    { "id": "s3.list_objects", "description": "List objects in a bucket.", "input": { "bucket": { "type": "string", "required": true }, "prefix": { "type": "string", "required": false } }, "output": { "objects": { "type": "array", "required": true } } },
    { "id": "s3.get_object", "description": "Read an object.", "input": { "bucket": { "type": "string", "required": true }, "key": { "type": "string", "required": true } }, "output": { "content_base64": { "type": "string", "required": true } } },
    { "id": "s3.put_object", "description": "Write an object.", "input": { "bucket": { "type": "string", "required": true }, "key": { "type": "string", "required": true }, "content_base64": { "type": "string", "required": true } }, "output": { "etag": { "type": "string", "required": true } } }
  ]
}
