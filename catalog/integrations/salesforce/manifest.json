{
  "id": "salesforce",
  "kind": "integration",
  "category": "crm",
  "transport": "native",
  "version": "1.0.0",
  "name": "Salesforce",
  "vendor": "Salesforce",
  "description": "Run SOQL, create leads, and update opportunities in Salesforce.",
  "intentHints": ["soql", "create a salesforce lead", "update an opportunity"],
  "authType": "oauth2",
  "oauthConfig": {
    "authorizeUrl": "https://login.salesforce.com/services/oauth2/authorize",
    "tokenUrl": "https://login.salesforce.com/services/oauth2/token",
    "scopes": ["api", "refresh_token"],
    "clientIdSecretRef": "secretsmanager:claritty/integrations/salesforce/client"
  },
  "providedTools": [
    { "id": "sfdc.soql_query", "description": "Run a SOQL query.", "input": { "soql": { "type": "string", "required": true } }, "output": { "records": { "type": "array", "required": true } } },
    { "id": "sfdc.create_lead", "description": "Create a Lead.", "input": { "first_name": { "type": "string", "required": false }, "last_name": { "type": "string", "required": true }, "email": { "type": "string", "required": false }, "company": { "type": "string", "required": true } }, "output": { "lead_id": { "type": "string", "required": true } } },
    { "id": "sfdc.update_opportunity", "description": "Update an Opportunity.", "input": { "opportunity_id": { "type": "string", "required": true }, "fields": { "type": "object", "required": true } }, "output": { "ok": { "type": "boolean", "required": true } } }
  ]
}
