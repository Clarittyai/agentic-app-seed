{
  "id": "postgres",
  "kind": "integration",
  "category": "data",
  "transport": "native",
  "version": "1.0.0",
  "name": "Postgres",
  "vendor": "PostgreSQL",
  "description": "Run read + write queries against a user-supplied Postgres connection.",
  "intentHints": ["query my database", "look up a row", "describe a postgres table"],
  "authType": "apiKey",
  "providedTools": [
    { "id": "pg.query", "description": "Run a parameterised SQL query.", "input": { "sql": { "type": "string", "required": true }, "params": { "type": "array", "required": false } }, "output": { "rows": { "type": "array", "required": true } } },
    { "id": "pg.list_tables", "description": "List tables in the public schema.", "input": {}, "output": { "tables": { "type": "array", "required": true } } },
    { "id": "pg.describe_table", "description": "Describe columns of a table.", "input": { "table": { "type": "string", "required": true } }, "output": { "columns": { "type": "array", "required": true } } }
  ]
}
