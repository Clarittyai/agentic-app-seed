{
  "id": "mailchimp",
  "kind": "integration",
  "category": "marketing",
  "transport": "mcp",
  "version": "0.1.0",
  "name": "Mailchimp",
  "vendor": "Mailchimp",
  "description": "Add subscribers and send campaigns via MCP.",
  "intentHints": ["add a subscriber", "send a campaign"],
  "authType": "apiKey",
  "mcpUrl": "https://mcp.example.com/mailchimp",
  "mcpAuth": { "type": "bearer", "envVar": "CLARITTY_MAILCHIMP_MCP_TOKEN" },
  "providedTools": [
    { "id": "mailchimp.add_subscriber", "description": "Add a subscriber to an audience.", "input": { "audience_id": { "type": "string", "required": true }, "email": { "type": "string", "required": true } }, "output": { "ok": { "type": "boolean", "required": true } } },
    { "id": "mailchimp.send_campaign", "description": "Send a prepared campaign.", "input": { "campaign_id": { "type": "string", "required": true } }, "output": { "ok": { "type": "boolean", "required": true } } }
  ]
}
