{
  "id": "microsoft-teams",
  "kind": "integration",
  "category": "communication",
  "transport": "native",
  "version": "1.0.0",
  "name": "Microsoft Teams",
  "vendor": "Microsoft",
  "description": "Post messages to Teams channels and chats.",
  "intentHints": ["post in teams", "send a teams message"],
  "authType": "oauth2",
  "oauthConfig": {
    "authorizeUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
    "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
    "scopes": ["Chat.ReadWrite", "ChannelMessage.Send", "offline_access"],
    "clientIdSecretRef": "secretsmanager:claritty/integrations/microsoft-teams/client"
  },
  "providedTools": [
    { "id": "teams.post_message", "description": "Post a message to a channel or chat.", "input": { "thread_id": { "type": "string", "required": true }, "content": { "type": "string", "required": true } }, "output": { "message_id": { "type": "string", "required": true } } },
    { "id": "teams.list_chats", "description": "List chats the user is in.", "input": {}, "output": { "chats": { "type": "array", "required": true } } }
  ]
}
