# Clarity Backend Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clarity

# Anthropic Claude API (Required for AI features)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false

# CORS (Frontend URL)
FRONTEND_URL=http://localhost:3200

# Scheduler (optional, for distributed deployments)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
