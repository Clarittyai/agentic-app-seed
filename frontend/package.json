{
  "name": "clarity-agentic-app-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "validate:widgets": "node ../scripts/validate-widgets.js",
    "check:identity": "node ../scripts/check-not-template.mjs",
    "test:widgets": "vitest run src/components/__tests__/Widget.test.tsx",
    "test:widgets:watch": "vitest watch src/components/__tests__/Widget.test.tsx",
    "test:widgets:coverage": "vitest run src/components/__tests__/Widget.test.tsx --coverage",
    "test:visual": "playwright test tests/widget-constraints.spec.ts",
    "test:visual:headed": "playwright test tests/widget-constraints.spec.ts --headed",
    "test:visual:debug": "playwright test tests/widget-constraints.spec.ts --debug",
    "test:all": "npm run check:identity && npm run validate:widgets && npm run test:widgets && npm run test:visual"
  },
  "dependencies": {
    "@clarittyai/app-ui": "^0.1.0",
    "@clarittyai/widget-toolkit": "^1.2.3",
    "axios": "^1.6.2",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.1.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  }
}
